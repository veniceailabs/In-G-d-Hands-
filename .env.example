# Add real values only in Vercel Environment Variables or a local .env file.
# Never commit private service-role credentials to the browser application.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Private owner console. Set this only in Vercel (never in browser code) before
# using /team-queue. Use a long, unique password; sessions last 15 minutes.
SUPPORT_QUEUE_PASSWORD=

# Private spaces use Supabase Auth anonymous sign-ins. The service role is used
# only by server routes and is never sent to the browser. Before public use,
# enable Anonymous Sign-Ins and CAPTCHA/abuse protection in Supabase Auth.

# Honey uses an OpenAI-compatible server-side chat provider. Keep this key in
# Vercel only - it must never be included in browser JavaScript.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Local Ollama option. Vercel cannot reach 127.0.0.1 on your Mac; production
# requires a dedicated authenticated HTTPS bridge or a future VPS endpoint.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_BEARER_TOKEN=

# Local production-bridge process. Generate one random value and set it both as
# OLLAMA_BRIDGE_TOKEN on this Mac and OLLAMA_BEARER_TOKEN in Vercel. The bridge
# listens only on loopback; a private authenticated tunnel must front it.
OLLAMA_BRIDGE_PORT=11435
OLLAMA_BRIDGE_TOKEN=
