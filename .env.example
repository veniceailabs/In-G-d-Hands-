# Add real values only in Vercel Environment Variables or a local .env file.
# Never commit private service-role credentials to the browser application.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Honey uses an OpenAI-compatible server-side chat provider. Keep this key in
# Vercel only - it must never be included in browser JavaScript.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Local Ollama option. Vercel cannot reach 127.0.0.1 on your Mac; production
# requires a dedicated authenticated HTTPS bridge or a future VPS endpoint.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_BEARER_TOKEN=
