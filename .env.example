# Add real values only in Vercel Environment Variables or a local .env file.
# Never commit private service-role credentials to the browser application.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Honey uses an OpenAI-compatible server-side chat provider. Keep this key in
# Vercel only - it must never be included in browser JavaScript.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
